{
  "regions": ["sin1", "bom1"],
  "crons": [
    {
      "path": "/api/cron/refresh-alpha-tracker",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/lottery-leaderboard",
      "schedule": "10 0 * * 1"
    }
  ],
  "functions": {
    "app/api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|svg|png|jpg|jpeg|gif|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
